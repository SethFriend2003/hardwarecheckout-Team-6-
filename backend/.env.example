# Copy this file to .env and keep .env out of git (it is already ignored).

# Local MongoDB, for example the Docker container from the README:
MONGODB_URI=mongodb://localhost:27017

# Shared MongoDB Atlas database. Comment out the line above and use this one instead,
# with the user, password and cluster host from the Atlas "Connect" dialog:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority

# Optional. Comma separated frontend URLs allowed to call this API. Defaults to any origin.
# CORS_ORIGINS=https://your-frontend.example.com
