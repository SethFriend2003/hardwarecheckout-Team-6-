# Copy this file to .env.local (ignored by git). Where the Flask API lives.
# The code falls back to http://127.0.0.1:5000 if this is unset, but macOS uses port 5000 for AirPlay.
VITE_API_URL=http://127.0.0.1:5001

# For a hosted build, point it at the deployed API, for example:
# VITE_API_URL=https://your-app-name.herokuapp.com
